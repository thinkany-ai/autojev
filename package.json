    "tauri": "node scripts/run-tauri.mjs",
    "dev:desktop": "pnpm tauri dev",
    "build:desktop": "tauri build",
    "icons": "node scripts/generate-icons.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:mac": "node scripts/release-mac.mjs",
    "test": "vitest run",
    "test:ui": "node scripts/check-availability-ui.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
