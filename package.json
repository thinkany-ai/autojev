{
  "name": "autojev",
  "private": true,
  "version": "0.1.3",
  "description": "A local model router for AI agents.",
  "license": "AGPL-3.0-only",
  "author": "ThinkAny, LLC",
  "homepage": "https://autojev.ai",
  "repository": {
    "type": "git",
