    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.12.2",
  "pnpm": {
    "overrides": {
      "@ungap/structured-clone": "1.3.3"
    }
  }
